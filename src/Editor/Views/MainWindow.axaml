
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Editor.Controls"
        x:Class="Editor.Views.MainWindow"
        Title="Editor"
        Width="1400"
        Height="850"
        MinWidth="980"
        MinHeight="600"
        Background="#0C131E">

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0"
                Background="#131E2D"
                Padding="16,12">

            <StackPanel Orientation="Horizontal"
                        Spacing="12">
                <Button Content="Новая сцена"
                        Click="NewSceneClicked" />

                <Button Content="Обновить списки"
                        Click="RefreshClicked" />

                <TextBlock Text="|"
                           VerticalAlignment="Center"
                           Foreground="#607188" />

                <TextBlock Text="{Binding SceneTitle}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="#DCEBFA" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1"
              ColumnDefinitions="235,*,235"
              ColumnSpacing="1">

            <Border Grid.Column="0"
                    Background="#162234"
                    Padding="12">

                <Grid RowDefinitions="Auto,Auto,*,Auto"
                      RowSpacing="10">

                    <TextBlock Text="ИСТОЧНИКИ"
                               FontWeight="Bold"
                               Foreground="#DCEBFA" />

                    <TextBlock Grid.Row="1"
                               Text="packs/import/levels"
                               FontSize="11"
                               Foreground="#91A6BD" />

                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding SourceLevels}"
                             SelectedItem="{Binding SelectedSource, Mode=TwoWay}" />

                    <Button Grid.Row="3"
                            Content="Импортировать"
                            Click="ImportClicked" />
                </Grid>
            </Border>

            <Grid Grid.Column="1"
                  RowDefinitions="*,Auto"
                  Background="#0C131E">

                <controls:SceneView x:Name="SceneView"
                                    Grid.Row="0" />

                <Border Grid.Row="1"
                        Background="#162234"
                        Padding="12">

                    <TextBlock Text="3D: ЛКМ — вращение, ПКМ/СКМ — перемещение, колесо — приближение. Пустая сцена при запуске."
                               Foreground="#91A6BD"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </Border>
            </Grid>

            <Border Grid.Column="2"
                    Background="#162234"
                    Padding="12">

                <Grid RowDefinitions="Auto,Auto,*,Auto,Auto"
                      RowSpacing="10">

                    <TextBlock Text="НАШ ФОРМАТ"
                               FontWeight="Bold"
                               Foreground="#DCEBFA" />

                    <TextBlock Grid.Row="1"
                               Text="packs/levels/*.zrlevel"
                               FontSize="11"
                               Foreground="#91A6BD" />

                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding SavedLevels}"
                             SelectedItem="{Binding SelectedPackage, Mode=TwoWay}" />

                    <Button Grid.Row="3"
                            Content="Открыть уровень"
                            Click="OpenClicked" />

                    <TextBlock Grid.Row="4"
                               Text="Текстуры: packs/textures (не копируются)"
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="#91A6BD" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="#131E2D"
                Padding="16,10">

            <TextBlock Text="{Binding StatusText}"
                       Foreground="#BFD4EA"
                       TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
