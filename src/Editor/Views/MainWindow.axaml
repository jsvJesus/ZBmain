<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Editor.Views.MainWindow"
        Title="Editor"
        Width="1280"
        Height="800"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A">
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Background="#111827" Padding="24,16">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="EDITOR" FontSize="23" FontWeight="Bold" Foreground="#F8FAFC" />
                    <TextBlock Text="Рабочее пространство · ресурсы и будущие инструменты"
                               Foreground="#94A3B8" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Обновить ресурсы"
                        Padding="16,9"
                        VerticalAlignment="Center"
                        Click="RefreshClicked" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="300,*" ColumnSpacing="1">
            <Border Grid.Column="0" Background="#141F31" Padding="18,20">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
                    <TextBlock Text="РЕСУРСЫ / PACKS"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#94A3B8" />
                    <TextBlock Grid.Row="1"
                               Text="Содержимое верхнего уровня"
                               Foreground="#CBD5E1" />
                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding Entries}"
                             SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                             Background="#172438"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="6,5" Spacing="2">
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding TypeName}"
                                               FontSize="11"
                                               Foreground="#94A3B8" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="#0F172A" Padding="32,28">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="14">
                    <TextBlock Text="ОБЛАСТЬ РЕДАКТОРА"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#60A5FA" />
                    <TextBlock Grid.Row="1"
                               Text="{Binding SelectedName}"
                               FontSize="26"
                               FontWeight="SemiBold"
                               Foreground="#F8FAFC"
                               TextWrapping="Wrap" />
                    <TextBlock Grid.Row="2"
                               Text="{Binding SelectedType, StringFormat='Тип: {0}'}"
                               Foreground="#CBD5E1" />
                    <TextBlock Grid.Row="3"
                               Text="{Binding SelectedPath}"
                               Foreground="#64748B"
                               TextWrapping="Wrap" />
                    <Border Grid.Row="4"
                            BorderBrush="#334155"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="24"
                            VerticalAlignment="Stretch">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                            <TextBlock Text="Рабочая область подготовлена"
                                       HorizontalAlignment="Center"
                                       FontSize="19"
                                       Foreground="#E2E8F0" />
                            <TextBlock Text="Здесь появятся инструменты карт, объектов и игровых ресурсов."
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Foreground="#94A3B8" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#111827" Padding="20,10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Text="{Binding StatusText}" Foreground="#CBD5E1" />
                <TextBlock Grid.Column="1" Text="Release · x64 · .NET 10" Foreground="#64748B" />
            </Grid>
        </Border>
    </Grid>
</Window>
